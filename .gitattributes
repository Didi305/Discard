# Tell GitHub Linguist to ignore build and config files
Makefile linguist-detectable=false
*.pro linguist-detectable=false
*.pri linguist-detectable=false
*.cmake linguist-detectable=false
CMakeLists.txt linguist-detectable=false

# Explicitly mark source code as C++
*.cpp linguist-language=C++
*.cc linguist-language=C++
*.cxx linguist-language=C++
*.hpp linguist-language=C++
*.h linguist-language=C++
