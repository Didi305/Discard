<RCC>
    <qresource prefix="/icons">
        <file>resources/icons/active.svg</file>
        <file>resources/icons/check.svg</file>
        <file>resources/icons/close.svg</file>
        <file>resources/icons/disturb.svg</file>
        <file>resources/icons/hidden.svg</file>
        <file>resources/icons/WAPP.ico</file>
    </qresource>

    <qresource prefix="/styles">
        <file alias="messageView.css">styles/messageView.css</file>
        <file alias="attachmentStrip.css">styles/attachmentStrip.css</file>
        <file alias="dark.qss">styles/dark.qss</file>
        <file alias="login_register.qss">styles/login_register.qss</file>
    </qresource>
    <qresource prefix="/config">
        <file alias="config.json">config/config.json</file>
    </qresource>
    <qresource prefix="/avatars">
        <file alias="default.png">uploads/imag.png</file>
    </qresource>
</RCC>
