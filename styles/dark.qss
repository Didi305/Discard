
#scrollAreaPending{
    border-top: 1px solid #3a3c43;
}
#Friends {
    border: 1px solid rgb(226, 52, 9);
}

#ADD_OUTGOING{
    border: 1px solid #3a3c43;
}

#scrollArea {
    border: 1px solid #3a3c43;
    border-left: none;
}

#ADD_OUTGOING QPushButton {
    background: transparent;
    qproperty-flat: true;
}
#decline:hover,
#cancel:hover{
    background: red;
}

#accept:hover{
    background: green;
}

Row {
  background: transparent
}

#avatar {
    color:yellow;
    background: transparent;
}


QFrame#userPanel {
            background-color:#32353a;
            border-radius: 4px;
        }

#disconnectButton{
    qproperty-flat: true;
    background: red;
}        
#disconnectButton:hover{color: #fff; background: white;}




































































QScrollBar:vertical {
    background: transparent;      
    width: 8px;              
}

QScrollBar::handle:vertical {
    background:rgb(70, 72, 75);          
    min-height: 40px;             
    border-radius: 4px;           
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed {
    background:rgb(78, 79, 85);          
}


QScrollBar::sub-line:vertical,
QScrollBar::add-line:vertical {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;             
}



QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background:rgb(24, 26, 27);
    min-width: 40px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    background: #5865f2;
}

QScrollBar::sub-line:horizontal,
QScrollBar::add-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}


