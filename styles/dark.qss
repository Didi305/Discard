
#scrollAreaPending{
    border-top: 1px solid #3a3c43;
}
#Friends {
    border: 1px solid rgb(226, 52, 9);
}

#ADD_OUTGOING{
    border: 1px solid #3a3c43;
}

#scrollArea {
    border: 1px solid #3a3c43;
    border-left: none;
}

#ADD_OUTGOING QPushButton {
    background: transparent;
    qproperty-flat: true;
}
#decline:hover,
#cancel:hover{
    background: red;
}

#accept:hover{
    background: green;
}

Row {
  background: transparent
}

#avatar {
    color:yellow;
    background: transparent;
}


#userPanel {
    border: none;
    border-radius: 14px;
    background: #3a3c43;
}

#disconnectButton{
    background: #3a3c43;
    qproperty-hover: true;
}        


#userAvatarButton{
  min-width: 48px; max-width: 48px;
  min-height: 48px; max-height: 48px;
  border-radius: 24px;
  background-color: gray;
  border: none;
}


#userNameLabel{
    font-weight: bold;
    font-size: 14px;
    font-family: "Segoe UI";
}

#something {
    background-color: #2b2d31;
    border: 1px solid #3a3c43;
    border-right: none;
}
#options {
    border-bottom: 1px solid #3a3c43;
}
#options QPushButton{
    background: transparent;
    text-align: left;
    padding-left: 8px;
    color: silver;
    font-weight: 625;
    font-size: 16px;
}
#options QPushButton:hover{
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
    border-radius: 8px;
}

























































QScrollBar:vertical {
    background: transparent;      
    width: 8px;              
}

QScrollBar::handle:vertical {
    background:rgb(70, 72, 75);          
    min-height: 40px;             
    border-radius: 4px;           
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed {
    background:rgb(78, 79, 85);          
}


QScrollBar::sub-line:vertical,
QScrollBar::add-line:vertical {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;             
}



QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background:rgb(24, 26, 27);
    min-width: 40px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    background: #5865f2;
}

QScrollBar::sub-line:horizontal,
QScrollBar::add-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}


