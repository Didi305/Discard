
QScrollArea, QFrame, #AddFriendPage, #DirectMessage, #scrollAreaWidgetContents {
    background-color: transparent;
    border: none;
}

#ADD_OUTGOING QPushButton {
    background: transparent;
    qproperty-flat: true;
}
#decline:hover,
#cancel:hover{
    background: red;
}

#accept:hover{
    background: green;
}

Row {
  background: transparent
}


#userPanel {
    border: none;
    border-radius: 14px;
    background-color: #2b2d31;
}

#disconnectButton{
    background: transparent;
    qproperty-hover: true;
}        


#userAvatarButton{
  min-width: 48px; max-width: 48px;
  min-height: 48px; max-height: 48px;
  border-radius: 24px;
  background-color: gray;
  border: none;
}


#userNameLabel{
    font-weight: bold;
    font-size: 14px;
    font-family: "Segoe UI";
}

#something {
    background-color: #030303ff;
    border-right: none;
}
#options {
    border-bottom: 1px solid #3a3c43;
}

#options QPushButton{
    background: transparent;
    text-align: left;
    padding-left: 8px;
    color: silver;
    font-weight: 625;
    font-size: 16px;
}

#options QPushButton:hover{
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
    border-radius: 8px;
}

#topBar {
    background: transparent;
    border: 0.5px solid #3a3c43;
}

#LEFT_TOPBAR {
    border: none;
    background-color: #030303ff;
}

#MID_RIGHT_TOPBAR {
    background: #2b2d31;
    border: none;
}

#MID_RIGHT_TOPBAR QPushButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.86);
    font-weight: 625;
    font-size: 16px;
}

#MID_RIGHT_TOPBAR QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
    border-radius: 8px;
}

#friendsLabel {
    color: rgba(255, 255, 255, 0.86);
    font-weight: 640;
    font-size: 18px;
}

#messageInputFrame {
    color: red;
}

#receiverInformationFrame {
    border: none;
}

#receiverUsername {
    color: rgba(255, 255, 255, 0.86);
    font-weight: 625;
    font-size: 25px;
}

#startConversationLabel {
    color: rgba(255, 255, 255, 0.86);
    font-weight: 640;
    font-size: 16px;
}

#messagesContainer {
    border-top: 1px solid #3a3c43;
}


#friendsScrollAreaContent {
    background:  #32353a;
}


#verticalLayoutMid {
    background: #2b2d31;
}

#messageInputFrame {
    background: #32353a;
    margin: 8px;
    border-radius: 2px;
}

#messageInputFrame QPushButton, QToolButton, QLineEdit {
    background: transparent;
}

#messageInputLine {
    color: rgba(255, 255, 255, 0.86);
    font-weight: 625;
    font-size: 15px;
}

#message {
    background: transparent;
    color: silver;
    font-weight: 625;
    font-size: 16px;
}

#timeLabel {
    background: transparent;
    color: silver;
    font-weight: 650;
    font-size: 11px;
}
















































QScrollBar:vertical {
    background: transparent;      
    width: 8px;              
}

QScrollBar::handle:vertical {
    background:rgb(70, 72, 75);          
    min-height: 40px;             
    border-radius: 4px;           
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed {
    background:rgb(78, 79, 85);          
}


QScrollBar::sub-line:vertical,
QScrollBar::add-line:vertical {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;             
}



QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background:rgb(24, 26, 27);
    min-width: 40px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    background: #5865f2;
}

QScrollBar::sub-line:horizontal,
QScrollBar::add-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}


